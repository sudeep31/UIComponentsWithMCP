      "$type": "shadow",
      "$description": "Default shadow — cards, dropdowns"
    },
    "lg": {
      "$value": "0 10px 15px rgba(0, 0, 0, 0.10)",
      "$type": "shadow",
      "$description": "Large shadow — modals, popovers"
    },
    "xl": {
      "$value": "0 20px 25px rgba(0, 0, 0, 0.12)",
